# The web address SYNiq will live at. Point its DNS A record at this server first.
DOMAIN=syniq.example.in

# A long random password for the database. For example: openssl rand -base64 24
POSTGRES_PASSWORD=

# Optional. Lets Ask SYNiq send questions its own content does not cover to Claude, and turns on AI drafting. The tutor works without it.
ANTHROPIC_API_KEY=

# Optional. Lets Ask SYNiq send questions its own content does not cover to OpenAI (max 20 per student per day).
OPENAI_API_KEY=
