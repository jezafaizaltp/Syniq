# The start script copies this to .env and fills in the password for you.

# A long random password for the database. Keep a copy somewhere safe.
POSTGRES_PASSWORD=

# The port students use. 80 means they type just the address, for example http://192.168.1.20
PORT=80

# Optional. Lets Ask SYNiq send questions its own content does not cover to Claude (needs internet). The tutor works without it.
ANTHROPIC_API_KEY=

# Optional. Lets Ask SYNiq send questions its own content does not cover to OpenAI (max 20 per student per day).
OPENAI_API_KEY=

# Optional and free (no card). Lets Ask SYNiq send questions its own content does not cover to
# Cloudflare Workers AI (max 20 per student per day). See docs/lab-pilot.md for how to get these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
